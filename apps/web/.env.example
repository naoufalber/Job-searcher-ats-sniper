# Local development defaults. Copy to .env.local and replace the anon key
# with the value printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Hosted staging/production values belong in environment-specific secret stores,
# never in this file. Do not add a service-role key to NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder
ATS_INGESTION_SHARED_SECRET=server-only-placeholder
